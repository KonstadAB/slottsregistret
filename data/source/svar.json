sv-template-portlet\n\" id=\"svid12_4215df4d191da8db619b1d68_svid30_1124f9d51611ae23d8852c5\"><div id=\"Kakmedvetenvelocity\"><!-- Kakmedveten velocity --></div>\n\n<div class=\"lp-webapp-kmv__missing-consent--readspeaker\">\n  <button\n     id=\"largeBtn\"\n     data-modal-dialog\n     data-target=\"#kmvReadspeakerTools\"\n     type=\"button\"\n     class=\"lp-webapp-kmv__missing-consent-button\"\n  >\n     Aktivera lyssna\n  </button>\n\n  <div\n     class=\"env-modal-dialog example-demo__modal\"\n     id=\"kmvReadspeakerTools\"\n     role=\"dialog\"\n     aria-modal=\"true\"\n     aria-labelledby=\"lp-webapp-kmv-modal-dialog__header\"\n     aria-hidden=\"true\"\n  >\n     <div class=\"env-modal-dialog__dialog env-modal-dialog__dialog--large\">\n        <section class=\"env-modal-dialog__content\">\n                     <div class=\"env-modal-dialog__header\">\n              <h2 class=\"env-modal-dialog__header__title lp-webapp-kmv__missing-consent-heading\" id=\"lp-webapp-kmv-modal-dialog__header\">Samtycke för funktionella kakor</h2>\n           </div>\n                     <div class=\"env-modal-dialog__body\">\n              <p class=\"env-text\">\n                För att använda lyssnafunktionen behöver du lämna ditt samtycke till funktionella kakor.\n              </p>\n           </div>\n           <div class=\"env-modal-dialog__footer\">\n              <a href=\"/appresource/5.70b4613318a1c003fe1ac14d/12.4215df4d191da8db619b1d68/accept\" class=\"env-button env-button--primary\">\n                 Samtyck till funktionella kakor\n              </a>\n              <button\n                 type=\"button\"\n                 data-modal-dialog-dismiss\n                 class=\"env-button env-button--link\"\n              >\n                 Avbryt\n              </button>\n           </div>\n        </section>\n     </div>\n  </div>\n</div>\n<script nonce=\"bd8e1f80-be5d-11f1-84df-75512d5d6029\">AppRegistry.registerApp({applicationId:'limepark.webapp-cookie-velocity|3.1.1',htmlElementId:'svid12_4215df4d191da8db619b1d68_svid30_1124f9d51611ae23d8852c5',route:'/',portletId:'12.4215df4d191da8db619b1d68',locale:'sv',defaultLocale:'en',webAppId:'limepark.webapp-cookie-velocity',webAppVersion:'3.1.1',webAppAopId:'360.4215df4d191da8db61983a0f',webAppImportTime:'1727177291749',requiredLibs:{}});</script></div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"sv-row sv-layout sv-template-layout\" id=\"svid10_1124f9d51611ae23d8852c6\"><div class=\"sv-layout lp-content sv-skip-spacer sv-column-8 sv-template-layout\" id=\"svid10_1124f9d51611ae23d8852c7\"><div class=\"sv-layout sv-skip-spacer sv-template-portlet\n\" id=\"svid30_1124f9d51611ae23d8852c8\"><div id=\"Sidverktyg\"><!-- Sidverktyg --></div></div>\n<div class=\"sv-vertical sv-layout sv-template-layout\" id=\"svid10_1124f9d51611ae23d8852c9\"><div id=\"svid94_70b4613318a1c003fe1ac154\" class=\"pagecontent sv-layout\"><div id=\"Mittenspalt\"><!-- Mittenspalt --></div><div class=\"sv-image-portlet sv-portlet sv-skip-spacer\" id=\"svid12_70b4613318a1c003fe1ac155\"><div id=\"Bild\"><!-- Bild --></div><a href=\"https://vr.kungligaslotten.se/vasa-to-bernadotte\" rel=\"external\"><img alt=\"\" class=\"sv-noborder c18329\"  width=\"1169\" height=\"585\" srcset=\"/images/18.70b4613318a1c003fe1b8c2a/1725476036299/x160p/vasa-bernadotte-vasatid-2.webp 160w, /images/18.70b4613318a1c003fe1b8c2a/1725476036299/x320p/vasa-bernadotte-vasatid-2.webp 320w, /images/18.70b4613318a1c003fe1b8c2a/1725476036299/x480p/vasa-bernadotte-vasatid-2.webp 480w, /images/18.70b4613318a1c003fe1b8c2a/1725476036299/x640p/vasa-bernadotte-vasatid-2.webp 640w, /images/18.70b4613318a1c003fe1b8c2a/1725476036299/x800p/vasa-bernadotte-vasatid-2.webp 800w, /images/18.70b4613318a1c003fe1b8c2a/1725476036299/x960p/vasa-bernadotte-vasatid-2.webp 960w, /images/18.70b4613318a1c003fe1b8c2a/1725476036299/x1120p/vasa-bernadotte-vasatid-2.webp 1120w, /images/18.70b4613318a1c003fe1b8c2a/1725476036299/vasa-bernadotte-vasatid-2.webp 1169w\" sizes=\"100vw\" src=\"/images/18.70b4613318a1c003fe1b8c2a/1725476036299/vasa-bernadotte-vasatid-2.webp\"></a></div>\n<div class=\"sv-row sv-layout\" id=\"svid10_70b4613318a1c003fe1ac156\"><div class=\"sv-layout sv-skip-spacer sv-column-4\" id=\"svid10_70b4613318a1c003fe1ac157\"><div class=\"sv-text-portlet sv-use-margins sv-skip-spacer\" id=\"svid12_70b4613318a1c003fe1ac158\"><div id=\"Rubrik\"><!-- Rubrik --></div><div class=\"sv-text-portlet-content\"><h1 class=\"heading\" id=\"h-VasatillBernadottei360\"><strong>’Vasa till Bernadotte’ i 360°</strong></h1></div></div>\n<div class=\"sv-text-portlet sv-use-margins\" id=\"svid12_70b4613318a1c003fe1ac159\"><div id=\"Ingress\"><!-- Ingress --></div><div class=\"sv-text-portlet-content\"><p class=\"preamble\">Besök utställningen <em>’Vasa till Bernadotte. Kultur i rikets tjänst’ </em>hemifrån. Följ med in i Kungliga slottet och upplev fem hundra år av hovkultur genom några av de kungliga samlingarnas absoluta höjdpunkter.</p></div></div>\n<div class=\"sv-text-portlet sv-use-margins\" id=\"svid12_70b4613318a1c003fe1ac15a\"><div id=\"Innehall\"><!-- Innehåll --></div><div class=\"sv-text-portlet-content\"><p class=\"normal\"><strong>Klicka på någon av bilderna för att starta den virtuella turen! </strong></p></div></div>\n<div class=\"sv-text-portlet sv-use-margins\" id=\"svid12_70b4613318a1c003fe1ac642\"><div id=\"Text\"><!-- Text --></div><div class=\"sv-text-portlet-content\"><p class=\"normal\">I den digitala versionen av utställningen kan du <em>&quot;vandra&quot; </em>runt, <em>zooma in</em> föremål och <em>klicka</em> på utvalda verk.</p><p class=\"normal\">Under de femhundra år som gått sedan kungavalet av Gustav Vasa 1523, har hovet varit en kulturmiljö i ständigt samspel med politiska omständigheter och internationell utveckling. En del är svensk historia, annat lever vidare i nutidens kulturliv och tillhör det nationen bär med sig till framtiden. Jubileumsutställningen på Kungliga slottet lyfter fram unika föremål som haft betydelse i den utvecklingen.</p><p class=\"normal\">Klicka på någon av bilderna för att starta turen. Dela gärna om du tycker att den är sevärd.</p><h2 class=\"subheading\" id=\"h-Utstallningskatalogochbokverk\">Utställningskatalog och bokverk</h2><p class=\"normal\">Utställningskatalogen och bokverket ”Vasa till Bernadotte” finns att köpa i vår webbutik <a href=\"http://www.kungligaslottsboden.se/\">www.kungligaslottsboden.se.<svg class=\"env-link-icon\" aria-hidden=\"true\"><use href=\"/sitevision/link-icons.svg#link-external\"></use></svg><span class=\"env-assistive-text\"> Länk till annan webbplats.</span></a></p></div></div>\n</div>\n<div class=\"sv-layout sv-column-4\" id=\"svid10_70b4613318a1c003fe1ac15b\"><div class=\"sv-image-portlet sv-portlet sv-skip-spacer\" id=\"svid12_70b4613318a1c003fe1ac15c\"><div id=\"Bild1\"><!-- Bild 1 --></div><a href=\"https://vr.kungligaslotten.se/vasa-to-bernadotte\" rel=\"external\"><img alt=\"\" class=\"sv-noborder c18331\"  width=\"991\" height=\"660\" srcset=\"/images/18.70b4613318a1c003fe1b8485/1694069882782/x160p/bernadotte-4.jpg 160w, /images/18.70b4613318a1c003fe1b8485/1694069882782/x320p/bernadotte-4.jpg 320w, /images/18.70b4613318a1c003fe1b8485/1694069882782/x480p/bernadotte-4.jpg 480w, /images/18.70b4613318a1c003fe1b8485/1694069882782/x640p/bernadotte-4.jpg 640w, /images/18.70b4613318a1c003fe1b8485/1694069882782/x800p/bernadotte-4.jpg 800w, /images/18.70b4613318a1c003fe1b8485/1694069882782/x960p/bernadotte-4.jpg 960w, /images/18.70b4613318a1c003fe1b8485/1694069882782/bernadotte-4.jpg 991w\" sizes=\"100vw\" src=\"/images/18.70b4613318a1c003fe1b8485/1694069882782/bernadotte-4.jpg\"></a><p class=\"env-text-caption-01\"><span class=\"sv-image-caption\">Vid utvalda verk finns information att läsa. Genom att klicka på de runda symbolerna på golvet tar du dig vidare i utställningen</span> </p></div>\n<div class=\"sv-image-portlet sv-portlet\" id=\"svid12_70b4613318a1c003fe1ad71a\"><div id=\"Bild2\"><!-- Bild 2 --></div><a href=\"https://vr.kungligaslotten.se/vasa-to-bernadotte\" rel=\"external\"><img alt=\"\" class=\"sv-noborder c18332\"  width=\"990\" height=\"659\" srcset=\"/images/18.70b4613318a1c003fe1b88c2/1694071416808/x160p/gustaviansk-3.jpg 160w, /images/18.70b4613318a1c003fe1b88c2/1694071416808/x320p/gustaviansk-3.jpg 320w, /images/18.70b4613318a1c003fe1b88c2/1694071416808/x480p/gustaviansk-3.jpg 480w, /images/18.70b4613318a1c003fe1b88c2/1694071416808/x640p/gustaviansk-3.jpg 640w, /images/18.70b4613318a1c003fe1b88c2/1694071416808/x800p/gustaviansk-3.jpg 800w, /images/18.70b4613318a1c003fe1b88c2/1694071416808/x960p/gustaviansk-3.jpg 960w, /images/18.70b4613318a1c003fe1b88c2/1694071416808/gustaviansk-3.jpg 990w\" sizes=\"100vw\" src=\"/images/18.70b4613318a1c003fe1b88c2/1694071416808/gustaviansk-3.jpg\"></a><p class=\"env-text-caption-01\"><span class=\"sv-image-caption\">Klicka på någon av bilderna för att starta turen. De virtuella visningarna kan du se från en smartphone eller dator.</span> </p></div>\n</div>\n</div>\n</div></div>\n<div class=\"sv-layout sv-template-portlet\n\" id=\"svid30_58fbba5d1623a378c483b35\"><div id=\"Extradela\"><!-- Extra dela --></div><div class=\"sv-script-portlet sv-portlet sv-skip-spacer sv-template-portlet\n\" id=\"svid12_42f96a77162194c1bf4d6a_svid30_58fbba5d1623a378c483b35\"><div id=\"SkriptDela-1\"><!-- Skript Dela --></div><a href=\"\" class=\"lp-extra-share-link\"><svg aria-hidden=\"true\" class=\"lp-icon\">\n  <use xmlns:xlink=\"http://www.w3.org/1999/xlink\" xlink:href=\"/webdav/files/system/svg/lp-icons.svg#lp-share\"></use>\n</svg>Dela sidan</a></div>\n</div>\n</div>\n<div class=\"sv-layout lp-submenu sv-column-4 sv-template-layout\" id=\"svid10_1124f9d51611ae23d8852cb\"><div class=\"sv-vertical sv-layout sv-skip-spacer sv-template-layout\" id=\"svid10_1124f9d51611ae23d8852cf\"><div id=\"svid94_70b4613318a1c003fe1ac15d\" class=\"pagecontent sv-layout\"><div id=\"Hogerspalt\"><!-- Högerspalt --></div><div class=\"sv-text-portlet sv-use-margins sv-skip-spacer sv-decoration-faktaruta\" id=\"svid12_70b4613318a1c003fe1ac776\"><div id=\"Text-0\"><!-- Text --></div><div class=\"sv-text-portlet-content\"><h2 class=\"subheading\" id=\"h-VASATILLBERNADOTTE\"><strong>VASA TILL BERNADOTTE <br></strong><strong>1523–1973–2023<br></strong><strong>KULTUR I RIKETS TJÄNST</strong></h2><p class=\"normal\">Utställningen visades på Kungliga slottet perioden 11 mars 2023 t.o.m. 7 januari 2024</p><h2 class=\"subheading\" id=\"h-Virtuellabesok\">Virtuella besök</h2><p class=\"sv-font-arrow-link\"><a href=\"https://www.kungligaslotten.se/artiklar-film-360.html?kategorier%5B%5D=360%C2%B0\">Se fler slottssalar och utställningar i 360<svg class=\"env-link-icon\" aria-hidden=\"true\"><use href=\"/sitevision/link-icons.svg#link-external\"></use></svg><span class=\"env-assistive-text\"> Länk till annan webbplats.</span></a>°</p><p class=\"sv-font-arrow-link\"><br></p></div></div>\n<div class=\"sv-text-portlet sv-use-margins\" id=\"svid12_70b4613318a1c003fe1aca69\"><div id=\"Text1\"><!-- Text 1 --></div><div class=\"sv-text-portlet-content\"><blockquote class=\"env-blockquote\"><p class=\"normal\"><q>Det är min förhoppning att jubileums­utställningen ska kunna bidra med ökad kunskap om Sveriges rika kulturhistoria och glänta på locket till alla de spännande berättelser som föremålen bär på.</q></p></blockquote></div></div>\n<div class=\"sv-text-portlet sv-use-margins\" id=\"svid12_70b4613318a1c003fe1acac5\"><div id=\"Text3\"><!-- Text 3 --></div><div class=\"sv-text-portlet-content\"><p class=\"normal\">— H.M. Konungen</p></div></div>\n</div></div>\n</div>\n</div>\n</div>\n<div class=\"sv-layout sv-template-portlet\n\" id=\"svid30_1124f9d51611ae23d8852d0\"><div id=\"Puffsektion\"><!-- Puffsektion --></div><div class=\"sv-vertical sv-layout sv-skip-spacer sv-template-layout\" id=\"svid10_4215df4d191da8db619b3395_svid30_1124f9d51611ae23d8852d0\"><div class=\"sv-vertical sv-l