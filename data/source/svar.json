b4f218ae95/1725478462163/x320p/gustav-IIIs-teater-gripsholms-slott-foto-alexis-daflos.webp 320w, /images/18.906e792161fb4f218ae95/1725478462163/x480p/gustav-IIIs-teater-gripsholms-slott-foto-alexis-daflos.webp 480w, /images/18.906e792161fb4f218ae95/1725478462163/x640p/gustav-IIIs-teater-gripsholms-slott-foto-alexis-daflos.webp 640w, /images/18.906e792161fb4f218ae95/1725478462163/x800p/gustav-IIIs-teater-gripsholms-slott-foto-alexis-daflos.webp 800w, /images/18.906e792161fb4f218ae95/1725478462163/gustav-IIIs-teater-gripsholms-slott-foto-alexis-daflos.webp 850w\" sizes=\"auto, 100vw\" src=\"/images/18.906e792161fb4f218ae95/1725478462163/gustav-IIIs-teater-gripsholms-slott-foto-alexis-daflos.webp\"></div>\n<div class=\"sv-row sv-layout\" id=\"svid10_74a76de4161fad9ce99779\"><div class=\"sv-layout sv-skip-spacer sv-column-4\" id=\"svid10_74a76de4161fad9ce9977a\"><div class=\"sv-text-portlet sv-use-margins sv-skip-spacer\" id=\"svid12_74a76de4161fad9ce9977b\"><div id=\"Rubrik\"><!-- Rubrik --></div><div class=\"sv-text-portlet-content\"><h1 class=\"heading\" id=\"h-GustavIIIsteater\">Gustav III:s teater</h1></div></div>\n<div class=\"sv-text-portlet sv-use-margins\" id=\"svid12_74a76de4161fad9ce99781\"><div id=\"Ingress\"><!-- Ingress --></div><div class=\"sv-text-portlet-content\"><p class=\"preamble\">Det säger mycket om Gustav III:s intresse för teater när han ansåg det nödvändigt att inrätta en komplett utrustad slottsteater på Gripsholms slott. Besök teatern virtuellt och följ med bakom kulisserna.</p></div></div>\n<div class=\"sv-text-portlet sv-use-margins sv-decoration-faktaruta\" id=\"svid12_153cdebf1715366693dffd\"><div id=\"Text1\"><!-- Text 1 --></div><div class=\"sv-text-portlet-content\"><h2 class=\"subheading\" id=\"h-Teaterni360\">Teatern i 360°</h2><p class=\"normal\">Gör en virtuell vandring i teatern från mobilen eller datorn. Zooma in miljöerna och läs om scenen, kungslogen, kulisserna och maskineriet.</p><p class=\"sv-font-arrow-link\"><a href=\"https://vr.kungligaslotten.se/teatern_gripsholmsslott/\">Starta turen<svg class=\"env-link-icon\" aria-hidden=\"true\"><use href=\"/sitevision/link-icons.svg#link-external\"></use></svg><span class=\"env-assistive-text\"> Länk till annan webbplats.</span></a></p><h2 class=\"subheading\" id=\"h-Foljmedbakomscenen\">Följ med bakom scenen</h2><p class=\"sv-font-arrow-link\"><a href=\"https://www.youtube.com/watch?v=X6KGD2rBaos\">Se filmen bakom kulisserna<svg class=\"env-link-icon\" aria-hidden=\"true\"><use href=\"/sitevision/link-icons.svg#link-external\"></use></svg><span class=\"env-assistive-text\"> Länk till annan webbplats.</span></a><br><br></p></div></div>\n<div class=\"sv-text-portlet sv-use-margins\" id=\"svid12_74a76de4161fad9ce99782\"><div id=\"Brodtext\"><!-- Brödtext --></div><div class=\"sv-text-portlet-content\"><h2 class=\"subheading\" id=\"h-Ettmasterstyckeskapas\">Ett mästerstycke skapas</h2><p class=\"normal\">Erik Palmstedt fick i uppdrag av Gustav III år 1781, att bygga en rymlig teater. Genom att göra en påbyggnad intill det givna tornutrymmet lyckades Palmstedt åstadkomma en för tidens krav fullt utrustad och funktionsduglig scen.</p><p class=\"normal\">Därtill skapade han ett åskådarutrymme som blivit ett mästerstycke inom nyklassicismens inredningskonst och vars särprägel framför allt ligger i kombinationen av intim stämning och monumental form.</p><h2 class=\"subheading\" id=\"h-Logerforbadekungligheterochtjanstefolk\">Loger för både kungligheter och tjänstefolk</h2><p class=\"normal\">Ovanför de trappstegsvis ordnade bänkraderna ligger den kungliga logen och ovanför den finns loger för uppvaktning och utländska sändebud. I kassettakets nedersta rad finns de så kallade lorgnetter för tjänstefolket.</p><p class=\"normal\">På sidorna om scenöppningen står gipsskulpturer av Johan Tobias Sergel föreställande Thalia och Melpomene som representerar komedien och tragedien.</p><p class=\"normal\"><em>Toppbilden: Scenen på Gustav III:s teater på Gripsholm. Foto: Alexis Daflos/Kungligaslotten.se</em></p></div></div>\n</div>\n<div class=\"sv-layout sv-column-4\" id=\"svid10_74a76de4161fad9ce9977e\"><div class=\"sv-image-portlet sv-portlet sv-skip-spacer\" id=\"svid12_153cdebf1715366693dffb\"><div id=\"Bild3\"><!-- Bild 3 --></div><a href=\"https://vr.kungligaslotten.se/teatern_gripsholmsslott/\"><img alt=\"\" class=\"sv-noborder c18013\"  width=\"410\" height=\"273\" srcset=\"/images/18.153cdebf1715366693df96/1586339215919/x160p/gustav-iii-teater-salong-virtuell-visning-360-gripsholms-slott.jpg 160w, /images/18.153cdebf1715366693df96/1586339215919/x320p/gustav-iii-teater-salong-virtuell-visning-360-gripsholms-slott.jpg 320w, /images/18.153cdebf1715366693df96/1586339215919/gustav-iii-teater-salong-virtuell-visning-360-gripsholms-slott.jpg 410w\" sizes=\"100vw\" src=\"/images/18.153cdebf1715366693df96/1586339215919/gustav-iii-teater-salong-virtuell-visning-360-gripsholms-slott.jpg\"></a><p class=\"env-text-caption-01\"><span class=\"sv-image-caption\">Upptäck teatern i 360°. Klicka på bilden för att starta den virtuella turen.</span> </p></div>\n<div class=\"sv-image-portlet sv-portlet\" id=\"svid12_7b2a8ac619367e5f49c269a5\"><div id=\"Bild4\"><!-- Bild 4 --></div><a href=\"https://youtu.be/X6KGD2rBaos?si=zrF8xB26COcvrmMm\" rel=\"external\"><img alt=\"\" class=\"sv-noborder c18013\"  width=\"410\" height=\"273\" srcset=\"/images/18.7b2a8ac619367e5f49c269a2/1732904623632/x160p/Gripsholm-teatern.jpg 160w, /images/18.7b2a8ac619367e5f49c269a2/1732904623632/x320p/Gripsholm-teatern.jpg 320w, /images/18.7b2a8ac619367e5f49c269a2/1732904623632/Gripsholm-teatern.jpg 410w\" sizes=\"100vw\" src=\"/images/18.7b2a8ac619367e5f49c269a2/1732904623632/Gripsholm-teatern.jpg\"></a><p class=\"env-text-caption-01\"><span class=\"sv-image-caption\">Följ med bakom kulisserna! Intendent Josefine Lindqvist tar oss med bakom scenen och visar den hemliga gången. Klicka på bilden för att se filmen på Youtube.</span> </p></div>\n<div class=\"sv-image-portlet sv-portlet\" id=\"svid12_74a76de4161fad9ce9977f\"><div id=\"Bild1\"><!-- Bild 1 --></div><img alt=\"\" loading=\"lazy\" class=\"sv-noborder c18013\"  width=\"410\" height=\"273\" srcset=\"/images/18.906e792161fb4f218ae82/1520601507981/x160p/gripsholms-slott-teater-kulisser.jpg 160w, /images/18.906e792161fb4f218ae82/1520601507981/x320p/gripsholms-slott-teater-kulisser.jpg 320w, /images/18.906e792161fb4f218ae82/1520601507981/gripsholms-slott-teater-kulisser.jpg 410w\" sizes=\"auto, 100vw\" src=\"/images/18.906e792161fb4f218ae82/1520601507981/gripsholms-slott-teater-kulisser.jpg\"><p class=\"env-text-caption-01\"><span class=\"sv-image-caption\">Kulisser, bakom scenen. Foto: Alexis Daflo/Kungligaslotten.se</span> </p></div>\n<div class=\"sv-image-portlet sv-portlet\" id=\"svid12_906e792161fb4f218aec2\"><div id=\"Bild2\"><!-- Bild 2 --></div><img alt=\"\" loading=\"lazy\" class=\"sv-noborder c18013\"  width=\"410\" height=\"273\" srcset=\"/images/18.906e792161fb4f218af52/1520609169650/x160p/gripsholms-slott-teater-askadarrummet-och-scen.jpg 160w, /images/18.906e792161fb4f218af52/1520609169650/x320p/gripsholms-slott-teater-askadarrummet-och-scen.jpg 320w, /images/18.906e792161fb4f218af52/1520609169650/gripsholms-slott-teater-askadarrummet-och-scen.jpg 410w\" sizes=\"auto, 100vw\" src=\"/images/18.906e792161fb4f218af52/1520609169650/gripsholms-slott-teater-askadarrummet-och-scen.jpg\"><p class=\"env-text-caption-01\"><span class=\"sv-image-caption\">Vänstra sidan av åskådarrummet och scenen. På sockeln står statyn Thalia av Johan Tobias Sergel. Foto: Alexis Daflos/Kungligaslotten.se</span> </p></div>\n</div>\n</div>\n</div></div>\n<div class=\"sv-layout sv-template-portlet\n\" id=\"svid30_58fbba5d1623a378c483b35\"><div id=\"Extradela\"><!-- Extra dela --></div><div class=\"sv-script-portlet sv-portlet sv-skip-spacer sv-template-portlet\n\" id=\"svid12_42f96a77162194c1bf4d6a_svid30_58fbba5d1623a378c483b35\"><div id=\"SkriptDela-1\"><!-- Skript Dela --></div><a h